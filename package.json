{
  "name": "asian-super-server",
  "version": "1.0.0",
  "description": "Asian Super Server - Deadlock Discord bot for Asia queue nights, live lobbies, and leaderboards",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "register-commands": "node src/commands/register.js",
    "sync-hero-emojis": "node src/scripts/syncHeroEmojis.js",
    "test": "node --require ./test/env.js --test test/steamId.test.js test/sanitize.test.js test/core.test.js",
    "check": "node scripts/syntax-check.js && npm test",
    "lint": "node scripts/syntax-check.js",
    "smoke": "node scripts/smoke-offline.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  }
}
